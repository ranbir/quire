#!/bin/sh
# quire — open files or folders in Quire.
#   quire file.txt other.swift     open files (created if missing)
#   quire .                        open a folder browser
#   some-command | quire           open piped text in a new document
#   quire -                        same, reading stdin explicitly
#   quire --export html|pdf doc.md [-o out] [--toc] [--title-page] …
#                                  export Markdown without opening a window

if [ "$1" = "--export" ]; then
    # Run the app binary directly: next to this script inside Quire.app, else the installed app.
    self="$0"
    while [ -L "$self" ]; do
        link="$(readlink "$self")"
        case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
    done
    bin="$(cd "$(dirname "$self")/../.." 2>/dev/null && pwd)/MacOS/Quire"
    [ -x "$bin" ] || bin="/Applications/Quire.app/Contents/MacOS/Quire"
    exec "$bin" "$@"
fi

if [ "$1" = "-" ] || { [ $# -eq 0 ] && [ ! -t 0 ]; }; then
    tmp="$(mktemp -t quire).txt"
    cat > "$tmp"
    exec open -a Quire "$tmp"
fi

if [ $# -eq 0 ]; then
    exec open -a Quire
fi

for f in "$@"; do
    [ -e "$f" ] || touch "$f"
done
exec open -a Quire "$@"
